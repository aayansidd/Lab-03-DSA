#include <iostream>
#include <string>
using namespace std;


struct Student{
	int rollno;
	string name;
	int marks;
};

void displayIfExists(const Student* s){
	if (s == nullptr){
		cout << "No record available" << endl;
	}
	else{
		cout << "Record exists" << endl;
	}
}

int main(){
	Student *s1;
	s1 = nullptr;
	displayIfExists(s1);

	s1 = new Student;
	cout << "Enter rollno: ";
	cin >> (*s1).rollno;  //derefencing object
	cin.ignore();
	cout << "Enter name: ";
	getline(cin, (*s1).name);

	cout << "Enter marks: ";
	cin >> (*s1).marks;

	displayIfExists(s1);

	delete s1;
	s1 = nullptr;
	displayIfExists(s1);
	return 0;

}
