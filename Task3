#include <iostream>
#include <string>
using namespace std;


struct student{
	int rollno;
	string name;
	int marks;
};

int main(){
	student *p = new student; //pointer to an record

	cout << "enter rollno: ";
	cin >> (*p).rollno;  //derefencing object
	cin.ignore();
	cout << "enter name: "; 
	getline(cin, (*p).name);

	cout << "enter marks: ";
	cin >> (*p).marks;

	cout << "rollno: " << p->rollno << endl;

	cout << "marks: " << p->marks << endl;
	cout << "name:" << p->name << endl;

	delete p;
	p = nullptr;

}
